{
  "name": "qtop",
  "version": "0.1.0",
  "description": "btop-like tiled system monitor TUI",
  "type": "module",
  "bin": { "qtop": "dist/index.js" },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "screenshot": "FORCE_COLOR=3 tsx scripts/screenshot.tsx"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "systeminformation": "^5.27.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
